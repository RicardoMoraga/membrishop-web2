# Dominio canónico. Sin barra final.
NEXT_PUBLIC_SITE_URL=https://membrishop.cl

# WhatsApp en formato internacional sin +, espacios ni guiones (Chile = 569XXXXXXXX)
NEXT_PUBLIC_WHATSAPP=56900000000

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Verificación de Google Search Console (metodo meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=

# ---------------------------------------------------------------------------
# Neon (PostgreSQL serverless)
# ---------------------------------------------------------------------------
# Cadena de conexión POOLED de Neon (la que dice "-pooler" en el host).
# Consola de Neon → tu proyecto → Connect → Connection string → Pooled connection.
# Debe terminar en ?sslmode=require
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/membrishop?sslmode=require

# Sal secreta para hashear la IP de quien envía formularios.
# Genera una con:  openssl rand -hex 32
# Si la cambias, el rate limit arranca de cero. No se rompe nada más.
LEAD_SALT=

# ---------------------------------------------------------------------------
# Shopify (Storefront API — compra directa)
# ---------------------------------------------------------------------------
# Dominio *.myshopify.com de la tienda REAL y conectada (no el dominio propio,
# y NO la tienda vieja "membrishoprm"). Verificado por Admin API: la única
# tienda con inventario real, Mercado Pago y la razón social vigente es esta.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=fyvfjt-vm.myshopify.com

# Token de Storefront API del canal Headless de esa misma tienda.
# Shopify Admin → Configuración → Apps y canales de venta → Headless →
# API de Storefront → generar/copiar token. Es público por diseño (viaja al
# navegador en apps 100% cliente), pero igual solo se usa desde el servidor
# aquí (src/lib/shopify.ts) para no exponerlo en el bundle.
SHOPIFY_STOREFRONT_TOKEN=

# El host de `checkoutUrl` lo decide Shopify según su dominio primario.
# No existe (ni debe existir) una variable de "checkout host": reescribir el
# host a mano rompe el checkout. Ver src/lib/shopify.ts.

# Tienda cerrada / abierta.
# Mientras la tienda Shopify tenga contraseña activa (Opening soon), cualquier
# checkoutUrl de Storefront API redirige a /password: un CTA "Comprar ahora"
# terminaría en una página muerta. Con esta variable en "false" o ausente, el
# frontend NO muestra "Comprar ahora" y usa WhatsApp como CTA principal en su
# lugar (mismo precio y stock reales, solo cambia el canal de cobro).
# Cambia a "true" el mismo día que quites la contraseña en Shopify: no hace
# falta tocar código, el CTA de compra directa vuelve a aparecer solo.
NEXT_PUBLIC_SHOPIFY_STORE_ABIERTA=false

# Secreto de firma de los webhooks `products/update` e `inventory_levels/update`
# de Shopify. Shopify Admin → Configuración → Notificaciones → Webhooks: al
# crear cada webhook, Shopify muestra la clave de firma (la misma para ambos
# si se crean desde la misma app). Sin esta variable la ruta /api/revalidate
# responde 503 y no invalida caché (falla cerrada, a propósito).
SHOPIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Confirmación de suscripción (double opt-in) — opcional
# ---------------------------------------------------------------------------
# Si defines esta clave, el aviso de reposición y el newsletter del footer
# envían un correo de confirmación real vía Resend (API HTTP, sin dependencia
# nueva) antes de activar la suscripción. Si la dejas vacía, el suscriptor
# queda guardado como "pendiente" (no recibe correos) y no se rompe nada: solo
# falta conectar el proveedor de correo.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MembriShop <avisos@membrishop.cl>
