# Dominio canónico. Sin barra final.
NEXT_PUBLIC_SITE_URL=https://membrishop.cl

# WhatsApp en formato internacional sin +, espacios ni guiones (Chile = 569XXXXXXXX)
NEXT_PUBLIC_WHATSAPP=56900000000

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Verificación de Google Search Console (metodo meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=

# ---------------------------------------------------------------------------
# Neon (PostgreSQL serverless)
# ---------------------------------------------------------------------------
# Cadena de conexión POOLED de Neon (la que dice "-pooler" en el host).
# Consola de Neon → tu proyecto → Connect → Connection string → Pooled connection.
# Debe terminar en ?sslmode=require
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/membrishop?sslmode=require

# Sal secreta para hashear la IP de quien envía formularios.
# Genera una con:  openssl rand -hex 32
# Si la cambias, el rate limit arranca de cero. No se rompe nada más.
LEAD_SALT=

# ---------------------------------------------------------------------------
# Shopify (Storefront API — compra directa)
# ---------------------------------------------------------------------------
# Dominio *.myshopify.com de la tienda (no el dominio propio).
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=membrishoprm.myshopify.com

# Token de Storefront API del canal "Membrishop Rm Headless".
# Shopify Admin → Configuración → Apps y canales de venta → Headless →
# API de Storefront → generar/copiar token. Es público por diseño (viaja al
# navegador en apps 100% cliente), pero igual solo se usa desde el servidor
# aquí (src/lib/shopify.ts) para no exponerlo en el bundle.
SHOPIFY_STOREFRONT_TOKEN=

# Host del checkout si se configura un subdominio propio para Shopify
# (por ejemplo comprar.membrishop.cl). Opcional: sin esto, `checkoutUrl`
# usa el dominio que Shopify entregue por defecto.
NEXT_PUBLIC_SHOPIFY_CHECKOUT_HOST=

# Secreto de firma del webhook `products/update` de Shopify.
# Shopify Admin → Configuración → Notificaciones → Webhooks: al crear el
# webhook, Shopify muestra la clave de firma. Sin esta variable la ruta
# /api/revalidate responde 503 y no invalida caché (falla cerrada, a propósito).
SHOPIFY_WEBHOOK_SECRET=
